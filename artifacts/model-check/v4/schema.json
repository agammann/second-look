{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "spanIds",
          "questionIds"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "spanIds": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s(?:[1-9]|[12][0-9]|3[0-2])$"
            }
          },
          "questionIds": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "q_scope",
                "q_clarify"
              ]
            }
          }
        }
      }
    }
  }
}
